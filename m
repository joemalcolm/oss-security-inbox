--- a/src/libsystemd/sd-bus/bus-socket.c
+++ b/src/libsystemd/sd-bus/bus-socket.c
@@ -1072,7 +1072,7 @@ static int bus_socket_read_message_need(sd_bus *bus, =
size_t *need) {
 }
=20
 static int bus_socket_make_message(sd_bus *bus, size_t size) {
-        sd_bus_message *t;
+        sd_bus_message *t =3D NULL;
         void *b;
         int r;
=20
@@ -1097,7 +1097,9 @@ static int bus_socket_make_message(sd_bus *bus, size_=
t size) {
                                     bus->fds, bus->n_fds,
                                     NULL,
                                     &t);
-        if (r < 0) {
+        if (r =3D=3D -EBADMSG)
+                log_debug_errno(r, "Received invalid message from connecti=
on %s, dropping.", strna(bus->description));
+        else if (r < 0) {
                 free(b);
                 return r;
         }
@@ -1108,7 +1110,8 @@ static int bus_socket_make_message(sd_bus *bus, size_=
t size) {
         bus->fds =3D NULL;
         bus->n_fds =3D 0;
=20
-        bus->rqueue[bus->rqueue_size++] =3D t;
+        if (t)
+                bus->rqueue[bus->rqueue_size++] =3D t;
=20
         return 1;
 }
