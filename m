> >                         len +=3D p->elem_len + 1;
> >         }
> >         n =3D xmalloc(len);
> >         m =3D n + len - (nlen + 1);
> >         memcpy(m, name, nlen + 1);
> >         for (p =3D path; p; p =3D p->up) {
> >                 if (p->elem_len) {
> >                         m -=3D p->elem_len + 1;
> >                         memcpy(m, p->elem, p->elem_len);
> >                         m[p->elem_len] =3D '/';
> >                 }
> >         }
> >         return n;
> >}
