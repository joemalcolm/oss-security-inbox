 name="CVE-2019-10190.patch"
Content-Transfer-Encoding: quoted-printable
Content-Disposition: attachment;
 filename="CVE-2019-10190.patch"

diff --git a/lib/resolve.c b/lib/resolve.c
index 59420238..c39eab41 100644
--- a/lib/resolve.c
+++ b/lib/resolve.c
@@ -555,15 +555,17 @@ static int answer_padding(struct kr_request *request)
=20
 static int answer_fail(struct kr_request *request)
 {
+	/* Note: OPT in SERVFAIL response is still useful for cookies/additional =
info. */
 	knot_pkt_t *answer =3D request->answer;
+	knot_rrset_t *opt_rr =3D answer->opt_rr; /* it gets NULLed below */
 	int ret =3D kr_pkt_clear_payload(answer);
 	knot_wire_clear_ad(answer->wire);
 	knot_wire_clear_aa(answer->wire);
 	knot_wire_set_rcode(answer->wire, KNOT_RCODE_SERVFAIL);
-	if (ret =3D=3D 0 && answer->opt_rr) {
-		/* OPT in SERVFAIL response is still useful for cookies/additional info.=
 */
+	if (ret =3D=3D 0 && opt_rr) {
 		knot_pkt_begin(answer, KNOT_ADDITIONAL);
 		answer_padding(request); /* Ignore failed padding in SERVFAIL answer. */
+		answer->opt_rr =3D opt_rr;
 		ret =3D edns_put(answer, false);
 	}
 	return ret;
@@ -1592,9 +1594,7 @@ int kr_resolve_finish(struct kr_request *request, int=
 state)
 {
 	/* Finalize answer and construct wire-buffer. */
 	ITERATE_LAYERS(request, NULL, answer_finalize);
-	if (request->state & KR_STATE_FAIL) {
-		state =3D KR_STATE_FAIL;
-	} else if (answer_finalize(request, state) !=3D 0) {
+	if (answer_finalize(request, state) !=3D 0) {
 		state =3D KR_STATE_FAIL;
 	}
=20

